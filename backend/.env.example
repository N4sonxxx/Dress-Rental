# Database
DATABASE_URL="postgresql://user:password@localhost:5432/glamourrent?schema=public"

# JWT
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:3000"

# File uploads configuration (Firebase Cloud Storage in Production)
UPLOAD_DIR="./uploads" # fallback for local
MAX_FILE_SIZE_MB=10

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
